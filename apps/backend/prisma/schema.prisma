generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  SPLIT
  CREDIT
  /// Virement / dépôt banque — crédite un compte, hors fond de caisse.
  BANK
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum FinanceType {
  INCOME
  EXPENSE
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum InventorySessionStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InventorySessionKind {
  OPENING
  CLOSING
  AD_HOC
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  CLOSED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
}

enum DeliveryStatus {
  PENDING
  PARTIAL
  DELIVERED
}

/// Direction / curseur de sync (métronome local ↔ GCP).
enum SyncDirection {
  PULL
  PUSH
}

/// Exercice comptable : ouvert (saisies possibles) ou clôturé (figé).
enum FiscalYearStatus {
  OPEN
  CLOSED
}

/// Statut d’une écriture de journal (partie double).
enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

/// Nature du compte pour le bilan / résultat (PCG style France–Haïti).
enum AccountNature {
  /// Classes 1–5 : bilan
  BALANCE_SHEET
  /// Classes 6–7 : charges / produits
  INCOME_STATEMENT
}

/// Journal d’origine (codes classiques).
enum JournalCode {
  VE /// Ventes
  AC /// Achats
  BQ /// Banque
  CA /// Caisse
  OD /// Opérations diverses
  AN /// À-nouveaux / ouverture
}

model Company {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  name             String
  legalName        String?
  address          String   @default("")
  city             String?
  country          String?
  phone            String?
  email            String?
  headerText       String?
  presentationText String?
  logoUrl          String?
  taxId            String?
  currency         String   @default("HTG")
  vatRatePercent   Decimal  @default(0) @db.Decimal(5, 2)
  departments      Department[]
  stores           Store[]
  products         Product[]
  productFamilies  ProductFamily[]
  users            User[]
  expenseCategories ExpenseCategory[]
  purchaseOrders   PurchaseOrder[]
  deliveries       Delivery[]
  creditCustomers  CreditCustomer[]
  banks            Bank[]
  bankAccounts     BankAccount[]
  accounts         Account[]
  fiscalYears      FiscalYear[]
  journalEntries   JournalEntry[]
  supplierPayments SupplierPayment[]
  fixedAssets      FixedAsset[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
}

model PackagingUnit {
  id               Int               @id @default(autoincrement())
  uuid             String            @unique @default(uuid())
  departmentId     Int
  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code             String
  label            String
  sortOrder        Int               @default(0)
  productSaleUnits ProductSaleUnit[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@unique([departmentId, code])
}

/// Département : unité autonome au sein de l’entreprise (stock, ventes, suivi) ; les produits y sont rattachés.
model Department {
  id             Int                       @id @default(autoincrement())
  uuid           String                    @unique @default(uuid())
  companyId      Int
  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  users          User[]
  products       Product[]
  packagingUnits PackagingUnit[]
  printerProfile DepartmentPrinterProfile?
  inventorySessions InventorySession[]
  registerSessions  RegisterSession[]
  registers         Register[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  deliveries        Delivery[]
  creditCustomers   CreditCustomer[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?

  @@unique([companyId, name])
}

/// Réglages ticket thermique par département (entête, pied, matériel, texte de test).
model DepartmentPrinterProfile {
  id                  Int        @id @default(autoincrement())
  uuid                String     @unique @default(uuid())
  departmentId        Int        @unique
  department          Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  paperWidth          Int        @default(58)
  deviceName          String     @default("")
  autoCut             Boolean    @default(true)
  showLogoOnReceipt   Boolean    @default(true)
  receiptHeaderText   String?
  receiptFooterText   String?
  receiptLogoUrl      String?
  previewSampleBody   String?
  /// Ordre de décaissement (dépenses manuelles).
  showLogoOnDisbursement      Boolean  @default(true)
  disbursementHeaderText      String?
  disbursementFooterText      String?
  disbursementLogoUrl         String?
  disbursementPreviewSampleBody String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?
}

model Store {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(uuid())
  companyId Int?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name      String
  address   String
  registers Register[]
  sales     Sale[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Register {
  id           Int         @id @default(autoincrement())
  uuid         String      @unique @default(uuid())
  code         String      @unique
  storeId      Int
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Caisse rattachée à un département (optionnel pour les anciennes caisses).
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sales        Sale[]
  sessions     RegisterSession[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  @@index([departmentId])
}

/// Session de travail caisse : ouverture (inventaire + fond) → ventes → fermeture (inventaire + espèces).
model RegisterSession {
  id                        Int                   @id @default(autoincrement())
  uuid                      String                @unique @default(uuid())
  registerId                Int
  register                  Register              @relation(fields: [registerId], references: [id], onDelete: Cascade)
  departmentId              Int
  department                Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  status                    RegisterSessionStatus @default(OPEN)
  openedById                Int
  openedBy                  User                  @relation("RegisterSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  openedAt                  DateTime              @default(now())
  closedById                Int?
  closedBy                  User?                 @relation("RegisterSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt                  DateTime?
  openingCashAmount         Decimal?              @db.Decimal(12, 2)
  closingCashExpected       Decimal?              @db.Decimal(12, 2)
  closingCashCounted        Decimal?              @db.Decimal(12, 2)
  cashVariance              Decimal?              @db.Decimal(12, 2)
  openingInventorySessionId Int                   @unique
  openingInventorySession   InventorySession      @relation("RegisterOpeningInventory", fields: [openingInventorySessionId], references: [id], onDelete: Restrict)
  closingInventorySessionId Int?                  @unique
  closingInventorySession   InventorySession?     @relation("RegisterClosingInventory", fields: [closingInventorySessionId], references: [id], onDelete: SetNull)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  deletedAt                 DateTime?
}

model Product {
  id           Int               @id @default(autoincrement())
  uuid         String            @unique @default(uuid())
  companyId    Int
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId Int?
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// Famille de prix volume (comptage croisé entre produits à la caisse).
  productFamilyId Int?
  productFamily   ProductFamily? @relation(fields: [productFamilyId], references: [id], onDelete: SetNull)
  sku          String?
  barcode      String?
  name         String
  cardColor    String?
  description  String?
  createdById  Int?
  updatedById  Int?
  createdBy    User?             @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?             @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  isService    Boolean           @default(false)
  trackStock   Boolean           @default(true)
  cost         Decimal           @default(0) @db.Decimal(12, 2)
  stock        Decimal           @default(0) @db.Decimal(12, 3)
  stockMin     Decimal           @default(0) @db.Decimal(12, 3)
  saleUnits    ProductSaleUnit[]
  saleItems    SaleItem[]
  movements    StockMovement[]
  inventoryLines InventoryLine[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  recipeAsParent     ProductRecipe? @relation("RecipeParent")
  recipeAsComponent  RecipeComponent[] @relation("RecipeComponent")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  @@index([productFamilyId])
}

/// Famille de produits : paliers de prix basés sur la quantité totale panier de la famille.
model ProductFamily {
  id        Int                 @id @default(autoincrement())
  uuid      String              @unique @default(uuid())
  companyId Int
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  products  Product[]
  tiers     ProductFamilyTier[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  @@index([companyId])
}

/// À partir de minQuantity (inclus) d’articles de la famille dans le panier, prix unitaire = unitPrice pour chaque ligne.
model ProductFamilyTier {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(uuid())
  productFamilyId Int
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  minQuantity     Decimal       @db.Decimal(12, 4)
  unitPrice       Decimal       @db.Decimal(12, 2)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@unique([productFamilyId, minQuantity])
}

model ProductSaleUnit {
  id              Int                   @id @default(autoincrement())
  uuid            String                @unique @default(uuid())
  productId       Int
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  packagingUnitId Int
  packagingUnit   PackagingUnit         @relation(fields: [packagingUnitId], references: [id], onDelete: Restrict)
  labelOverride   String?
  /// Toujours 1 pour le flux « une unité de vente = une unité de stock » (quantités décimales : 0,5 caisse).
  unitsPerPackage Decimal               @default(1) @db.Decimal(12, 4)
  salePrice       Decimal               @db.Decimal(12, 2)
  isDefault       Boolean               @default(false)
  saleItems       SaleItem[]
  volumePrices    ProductVolumePrice[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  @@unique([productId, packagingUnitId])
}

/// Rabais par volume : à partir de minQuantity (inclus), le prix unitaire devient unitPrice.
model ProductVolumePrice {
  id                Int             @id @default(autoincrement())
  uuid              String          @unique @default(uuid())
  productSaleUnitId Int
  productSaleUnit   ProductSaleUnit @relation(fields: [productSaleUnitId], references: [id], onDelete: Cascade)
  minQuantity       Decimal         @db.Decimal(12, 4)
  unitPrice         Decimal         @db.Decimal(12, 2)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@unique([productSaleUnitId, minQuantity])
}

model Sale {
  id         Int         @id @default(autoincrement())
  uuid       String      @unique @default(uuid())
  /// Numéro métier imprimé / affiché (conservé au sync ; distinct de l’id local).
  txnNumber  Int?
  /// UUID généré côté client (offline) pour idempotence push.
  clientUuid String?     @unique
  total      Decimal     @db.Decimal(12, 2)
  subtotal   Decimal     @default(0) @db.Decimal(12, 2)
  tax        Decimal     @default(0) @db.Decimal(12, 2)
  status     SaleStatus  @default(COMPLETED)
  cashier    String?
  clientName String?
  /// Client crédit (null = vente caisse classique).
  creditCustomerId Int?
  creditCustomer   CreditCustomer? @relation(fields: [creditCustomerId], references: [id], onDelete: SetNull)
  /// Montant déjà encaissé (acomptes + remboursements crédit / encaissement POS).
  amountPaid Decimal     @default(0) @db.Decimal(12, 2)
  /// Espèces tendues par le client à l’encaissement POS (peut différer du total).
  amountReceived Decimal @default(0) @db.Decimal(12, 2)
  /// Monnaie encore due au client (0 = réglée ou aucune).
  changeDue Decimal      @default(0) @db.Decimal(12, 2)
  changeSettledAt DateTime?
  cashBalanceSettledAt DateTime?
  items      SaleItem[]
  payments   Payment[]
  creditPayments CreditPayment[]
  userId     Int?
  storeId    Int?
  registerId Int?
  user       User?       @relation(fields: [userId], references: [id])
  store      Store?      @relation(fields: [storeId], references: [id])
  register   Register?   @relation(fields: [registerId], references: [id])
  /// Ligne de journal (encaissement) liée à cette vente — une entrée INCOME par vente POS cash.
  financeEntry FinanceEntry?
  delivery   Delivery?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  @@index([creditCustomerId, createdAt])
  @@index([changeDue, status])
  @@index([amountPaid, status])
  @@index([txnNumber])
}

model SaleItem {
  id                Int              @id @default(autoincrement())
  uuid              String           @unique @default(uuid())
  quantity          Decimal          @db.Decimal(12, 4)
  baseQuantity      Decimal          @db.Decimal(12, 4)
  unitPrice         Decimal          @db.Decimal(12, 2)
  subtotal          Decimal          @db.Decimal(12, 2)
  lineLabel         String?
  saleId            Int
  productId         Int
  productSaleUnitId Int?
  sale              Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product           Product          @relation(fields: [productId], references: [id])
  productSaleUnit   ProductSaleUnit? @relation(fields: [productSaleUnitId], references: [id])
  deliveryItem      DeliveryItem?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
}

/// Suivi de livraison d’une vente (fiche) — une livraison par vente complétée.
model Delivery {
  id            Int            @id @default(autoincrement())
  uuid          String         @unique @default(uuid())
  saleId        Int            @unique
  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId  Int?
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status        DeliveryStatus @default(PENDING)
  note          String?
  deliveredAt   DateTime?
  deliveredById Int?
  deliveredBy   User?          @relation("DeliveryDeliveredBy", fields: [deliveredById], references: [id], onDelete: SetNull)
  items         DeliveryItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([companyId, departmentId, status])
  @@index([status, createdAt])
}

model DeliveryItem {
  id                Int      @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  deliveryId        Int
  delivery          Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  saleItemId        Int      @unique
  saleItem          SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  quantityOrdered   Decimal  @db.Decimal(12, 4)
  quantityDelivered Decimal  @default(0) @db.Decimal(12, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([deliveryId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  uuid          String        @unique @default(uuid())
  saleId        Int
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?
  /// Compte crédité lorsque method = BANK.
  bankAccountId Int?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([bankAccountId])
}

model StockMovement {
  id          Int          @id @default(autoincrement())
  uuid        String       @unique @default(uuid())
  productId   Int
  quantity    Decimal      @db.Decimal(12, 4)
  type        MovementType
  reason      String?
  createdById Int?
  inventorySessionId Int?
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  inventorySession InventorySession? @relation(fields: [inventorySessionId], references: [id], onDelete: SetNull)
  goodsReceiptId Int?
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

/// Session d’inventaire physique par département (brouillon → validation → ajustements de stock).
model InventorySession {
  id             Int                    @id @default(autoincrement())
  uuid           String                 @unique @default(uuid())
  departmentId   Int
  department     Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  status         InventorySessionStatus @default(DRAFT)
  kind           InventorySessionKind   @default(AD_HOC)
  label          String?
  note           String?
  createdById    Int?
  createdBy      User?                  @relation("InventorySessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedById  Int?
  completedBy    User?                  @relation("InventorySessionCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  cancelledById  Int?
  cancelledBy    User?                  @relation("InventorySessionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  completedAt    DateTime?
  lines          InventoryLine[]
  stockMovements StockMovement[]
  registerSessionOpening RegisterSession? @relation("RegisterOpeningInventory")
  registerSessionClosing RegisterSession? @relation("RegisterClosingInventory")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
}

model InventoryLine {
  id              Int               @id @default(autoincrement())
  uuid            String            @unique @default(uuid())
  sessionId       Int
  session         InventorySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Stock théorique au moment de l’ouverture de la ligne (référence affichage).
  systemQtyAtOpen Decimal           @db.Decimal(12, 3)
  countedQty      Decimal?          @db.Decimal(12, 3)
  note            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@unique([sessionId, productId])
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  uuid          String              @unique @default(uuid())
  companyId     Int
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId  Int
  department    Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  supplierName  String?
  status        PurchaseOrderStatus @default(DRAFT)
  reference     String?
  note          String?
  createdById   Int?
  createdBy     User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
}

model PurchaseOrderLine {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(uuid())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityOrdered Decimal       @db.Decimal(12, 4)
  unitPriceEst    Decimal?      @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@unique([purchaseOrderId, productId])
}

/// Réception marchandise : brouillon → POSTED → entrées stock + coût moyen pondéré.
model GoodsReceipt {
  id              Int                   @id @default(autoincrement())
  uuid            String                @unique @default(uuid())
  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  departmentId    Int
  department      Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  status          GoodsReceiptStatus @default(DRAFT)
  receivedAt      DateTime            @default(now())
  note            String?
  createdById     Int?
  createdBy       User?               @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines           GoodsReceiptLine[]
  stockMovements  StockMovement[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?
}

model GoodsReceiptLine {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(uuid())
  goodsReceiptId Int
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal      @db.Decimal(12, 4)
  unitCost       Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([goodsReceiptId, productId])
}

/// Recette (BOM) : produit parent (souvent service) → composants MP consommés par unité de base du parent.
model ProductRecipe {
  id              Int               @id @default(autoincrement())
  uuid            String            @unique @default(uuid())
  parentProductId Int               @unique
  parentProduct   Product           @relation("RecipeParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  components      RecipeComponent[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
}

model RecipeComponent {
  id             Int           @id @default(autoincrement())
  uuid           String        @unique @default(uuid())
  recipeId       Int
  recipe         ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  componentProductId Int
  componentProduct Product     @relation("RecipeComponent", fields: [componentProductId], references: [id], onDelete: Restrict)
  /// Quantité de MP consommée par 1 unité de base du produit parent (même unité que Product.stock).
  quantityPerParentBaseUnit Decimal @db.Decimal(12, 4)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@unique([recipeId, componentProductId])
}

model ExpenseCategory {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  entries   FinanceEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([companyId, name])
}

model FinanceEntry {
  id          Int               @id @default(autoincrement())
  uuid        String            @unique @default(uuid())
  type        FinanceType
  amount      Decimal           @db.Decimal(12, 2)
  description String
  /// Précisions libres (optionnel) en plus du libellé.
  detail      String?
  categoryId  Int?
  category    ExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId      Int?
  user        User?             @relation("FinanceEntryUser", fields: [userId], references: [id])
  saleId      Int?              @unique
  sale        Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  creditPayment CreditPayment?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
}

/// Client autorisé à acheter à crédit (fiche AR).
model CreditCustomer {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(uuid())
  companyId    Int
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name         String
  phone        String?
  address      String?
  note         String?
  creditLimit  Decimal   @default(0) @db.Decimal(12, 2)
  isActive     Boolean   @default(true)
  sales        Sale[]
  payments     CreditPayment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([companyId, isActive])
  @@index([companyId, name])
}

/// Encaissement / remboursement sur une créance (écriture cash → FinanceEntry INCOME).
model CreditPayment {
  id               Int            @id @default(autoincrement())
  uuid             String         @unique @default(uuid())
  creditCustomerId Int
  creditCustomer   CreditCustomer @relation(fields: [creditCustomerId], references: [id], onDelete: Cascade)
  saleId           Int?
  sale             Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  amount           Decimal        @db.Decimal(12, 2)
  method           PaymentMethod  @default(CASH)
  reference        String?
  /// Compte crédité lorsque method = BANK.
  bankAccountId    Int?
  bankAccount      BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  note             String?
  userId           Int?
  user             User?          @relation("CreditPaymentUser", fields: [userId], references: [id], onDelete: SetNull)
  financeEntryId   Int?           @unique
  financeEntry     FinanceEntry?  @relation(fields: [financeEntryId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  @@index([creditCustomerId, createdAt])
  @@index([saleId, createdAt])
  @@index([bankAccountId])
}

/// Banque (établissement) où l’entreprise détient des comptes.
model Bank {
  id        Int           @id @default(autoincrement())
  uuid      String        @unique @default(uuid())
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  note      String?
  isActive  Boolean       @default(true)
  accounts  BankAccount[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([companyId, isActive])
  @@index([companyId, name])
}

/// Compte bancaire rattaché à une banque.
model BankAccount {
  id             Int               @id @default(autoincrement())
  uuid           String            @unique @default(uuid())
  companyId      Int
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankId         Int
  bank           Bank              @relation(fields: [bankId], references: [id], onDelete: Cascade)
  name           String
  accountNumber  String?
  openingBalance Decimal           @default(0) @db.Decimal(12, 2)
  isActive       Boolean           @default(true)
  note           String?
  transactions   BankTransaction[]
  payments       Payment[]
  creditPayments CreditPayment[]
  supplierPayments SupplierPayment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([companyId, isActive])
  @@index([bankId, isActive])
}

/// Mouvement manuel sur un compte bancaire.
model BankTransaction {
  id            Int                 @id @default(autoincrement())
  uuid          String              @unique @default(uuid())
  bankAccountId Int
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  type          BankTransactionType
  amount        Decimal             @db.Decimal(12, 2)
  description   String
  reference     String?
  occurredAt    DateTime            @default(now())
  userId        Int?
  user          User?               @relation("BankTransactionUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@index([bankAccountId, occurredAt])
  @@index([occurredAt])
}

model CashClosure {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(uuid())
  registerId     Int?
  expectedAmount Decimal   @db.Decimal(12, 2)
  countedAmount  Decimal   @db.Decimal(12, 2)
  variance       Decimal   @db.Decimal(12, 2)
  createdById    Int?
  createdBy      User?     @relation("CashClosureCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model AppRole {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  code        String    @unique
  label       String
  description String?
  permissions String[]
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model User {
  id           Int            @id @default(autoincrement())
  uuid         String         @unique @default(uuid())
  email        String?
  phone        String         @unique
  password     String
  role         String         @default("CASHIER")
  fullName     String?
  isActive     Boolean        @default(true)
  companyId    Int?
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  departmentId Int?
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sales        Sale[]
  sessions     Session[]
  auditLogs    AuditLog[]
  stockMoves   StockMovement[] @relation("StockMovementCreatedBy")
  inventorySessionsCreated InventorySession[] @relation("InventorySessionCreatedBy")
  inventorySessionsCompleted InventorySession[] @relation("InventorySessionCompletedBy")
  inventorySessionsCancelled InventorySession[] @relation("InventorySessionCancelledBy")
  productsCreated Product[] @relation("ProductCreatedBy")
  productsUpdated Product[] @relation("ProductUpdatedBy")
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  goodsReceiptsCreated  GoodsReceipt[] @relation("GoodsReceiptCreatedBy")
  financeEntries FinanceEntry[] @relation("FinanceEntryUser")
  cashClosures CashClosure[] @relation("CashClosureCreatedBy")
  creditPayments CreditPayment[] @relation("CreditPaymentUser")
  bankTransactions BankTransaction[] @relation("BankTransactionUser")
  registerSessionsOpened RegisterSession[] @relation("RegisterSessionOpenedBy")
  registerSessionsClosed RegisterSession[] @relation("RegisterSessionClosedBy")
  deliveriesDelivered Delivery[] @relation("DeliveryDeliveredBy")
  fiscalYearsClosed FiscalYear[] @relation("FiscalYearClosedBy")
  journalEntriesCreated JournalEntry[] @relation("JournalEntryCreatedBy")
  supplierPayments SupplierPayment[] @relation("SupplierPaymentUser")
  fixedAssetsCreated FixedAsset[] @relation("FixedAssetCreatedBy")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
}

/// Compte du plan comptable (PCG commerce Haïti / France).
model Account {
  id          Int           @id @default(autoincrement())
  uuid        String        @unique @default(uuid())
  companyId   Int
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Numéro PCG (ex. 411, 530, 707).
  code        String
  name        String
  /// Classe 1–7.
  classNumber Int
  nature      AccountNature
  /// true = solde normal débiteur (actif, charges) ; false = créditeur (passif, produits).
  isDebitNormal Boolean      @default(true)
  /// Clé système pour auto-imputation (CASH, CUSTOMERS, SALES…).
  systemKey   String?
  isSystem    Boolean       @default(false)
  isActive    Boolean       @default(true)
  parentId    Int?
  parent      Account?      @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Account[]     @relation("AccountTree")
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@unique([companyId, systemKey])
  @@index([companyId, classNumber, isActive])
}

/// Exercice comptable (année fiscale) — seul un exercice OPEN accepte des écritures.
model FiscalYear {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(uuid())
  companyId   Int
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label       String
  startDate   DateTime         @db.Date
  endDate     DateTime         @db.Date
  status      FiscalYearStatus @default(OPEN)
  closedAt    DateTime?
  closedById  Int?
  closedBy    User?            @relation("FiscalYearClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  entries     JournalEntry[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, label])
  @@index([companyId, status])
  @@index([companyId, startDate, endDate])
}

/// Écriture de journal (en-tête) — toujours équilibrée débit = crédit.
model JournalEntry {
  id           Int                 @id @default(autoincrement())
  uuid         String              @unique @default(uuid())
  companyId    Int
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYearId Int
  fiscalYear   FiscalYear          @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  entryDate    DateTime            @db.Date
  journalCode  JournalCode         @default(OD)
  /// Numéro séquentiel dans l’exercice (ex. VE-00042).
  entryNumber  Int
  reference    String?
  description  String
  /// Origine métier : SALE, CREDIT_SALE, CREDIT_PAYMENT, EXPENSE, PURCHASE, BANK, MANUAL, OPENING, CLOSING…
  source       String
  sourceId     String?
  status       JournalEntryStatus  @default(POSTED)
  createdById  Int?
  createdBy    User?               @relation("JournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines        JournalLine[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  @@unique([fiscalYearId, journalCode, entryNumber])
  @@unique([companyId, source, sourceId])
  @@index([companyId, entryDate])
  @@index([fiscalYearId, entryDate])
  @@index([companyId, status, entryDate])
}

/// Ligne d’écriture (mouvement sur un compte).
model JournalLine {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(uuid())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      Int
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  label          String?
  debit          Decimal      @default(0) @db.Decimal(14, 2)
  credit         Decimal      @default(0) @db.Decimal(14, 2)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([accountId])
  @@index([journalEntryId, sortOrder])
}

/// Paiement fournisseur — solde le compte 401 (Dr Fournisseurs / Cr Caisse ou Banque).
model SupplierPayment {
  id            Int           @id @default(autoincrement())
  uuid          String        @unique @default(uuid())
  companyId     Int
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierName  String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CASH)
  bankAccountId Int?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  /// Lien optionnel vers une réception d’achat.
  goodsReceiptId Int?
  note          String?
  paidAt        DateTime      @default(now())
  userId        Int?
  user          User?         @relation("SupplierPaymentUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([companyId, paidAt])
  @@index([companyId, supplierName])
}

/// Immobilisation corporelle — amortissement linéaire mensuel (681 / 281).
model FixedAsset {
  id                      Int       @id @default(autoincrement())
  uuid                    String    @unique @default(uuid())
  companyId               Int
  company                 Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                    String
  /// Date d’acquisition (début amortissement le mois suivant ou le mois d’acquisition).
  acquisitionDate         DateTime  @db.Date
  acquisitionCost         Decimal   @db.Decimal(14, 2)
  residualValue           Decimal   @default(0) @db.Decimal(14, 2)
  usefulLifeMonths        Int
  /// Cumul des amortissements déjà passés.
  accumulatedDepreciation Decimal   @default(0) @db.Decimal(14, 2)
  /// Dernière période amortie (YYYY-MM) ou null.
  lastDepreciationPeriod  String?
  isActive                Boolean   @default(true)
  note                    String?
  createdById             Int?
  createdBy               User?     @relation("FixedAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  @@index([companyId, isActive])
}

model Session {
  id           Int       @id @default(autoincrement())
  userId       Int
  refreshToken String
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

/// État du métronome sync (un curseur par entité / direction / nœud distant).
model SyncState {
  id             Int           @id @default(autoincrement())
  /// Identifiant du nœud distant (ex. "gcp", "local-mother").
  remoteNodeId   String
  /// Nom d’entité sync (ex. "Product", "Sale", "Asset").
  entity         String
  direction      SyncDirection
  /// Curseur ISO (updatedAt) du dernier enregistrement traité avec succès.
  lastCursorAt   DateTime?
  lastSuccessAt  DateTime?
  lastError      String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([remoteNodeId, entity, direction])
  @@index([remoteNodeId, entity])
}
