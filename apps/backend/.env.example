# Dev local — Postgres Eau Cascade (port 5434, DB pos_eau_cascade)
# docker compose -f infra/docker/docker-compose.local-postgres.yml up -d
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/pos_eau_cascade?schema=public"

# Si vous avez l erreur P6001 / prisma://, regenerez le client avec: npm run prisma:generate
JWT_SECRET="super_secret_change_me"
PORT=3000
TZ=America/Port-au-Prince

# Clé partagée sync-agent ↔ API (header X-Sync-Key). Obligatoire pour /sync/*.
# SYNC_API_KEY="change_me_long_random"
