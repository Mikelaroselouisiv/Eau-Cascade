    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.2",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-bluetooth-classic": "^1.73.0-rc.17",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "upng-js": "^2.1.0"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-file-system",
          "expo-intent-launcher"
        ]
      },
      "apple": {
        "exclude": [
          "expo-file-system",
          "expo-intent-launcher"
        ]
      }
    }
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@types/react": "~19.2.2",
    "@types/upng-js": "^2.1.5",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:android:apk": "expo prebuild --platform android --clean && ./android/gradlew -p android assembleRelease -Dorg.gradle.jvmargs=\"-Xmx8192m -XX:MaxMetaspaceSize=2048m\" --max-workers=2 --no-watch-fs"
  },
  "private": true
