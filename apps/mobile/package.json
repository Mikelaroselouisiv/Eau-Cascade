{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.6",
  "dependencies": {
    "@expo/ui": "~57.0.4",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "axios": "^1.18.1",
    "expo": "~57.0.4",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.5",
